# Maintainer: Styler contributors
pkgname=styler
pkgver=0.9.10
pkgrel=1
pkgdesc="Integrate semantic, reproducible changes on Linux"
arch=('any')
license=('Apache-2.0')
depends=('python>=3.10' 'python-textual>=0.89.1' 'python-yaml')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-asyncio')
optdepends=('kdialog: native KDE file and directory selectors'
            'zenity: native GTK file and directory selectors'
            'python-atspi: semantic desktop waits and actions')
install=styler.install
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  PYTHONPATH=. python -m pytest -q
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 packaging/linux/styler.desktop \
    "${pkgdir}/usr/share/applications/styler.desktop"
  install -Dm644 packaging/linux/styler-package.xml \
    "${pkgdir}/usr/share/mime/packages/styler-package.xml"
  install -Dm644 docs/styler.1 "${pkgdir}/usr/share/man/man1/styler.1"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
