pkgname=styler
pkgver=0.9.1
pkgrel=1
pkgdesc="Integrate semantic, reproducible changes on Linux"
arch=('any')
license=('Apache-2.0')
depends=('python>=3.10')
optdepends=('kdialog: native KDE file and directory selectors'
            'zenity: native GTK file and directory selectors'
            'python-atspi: semantic desktop waits and actions')
install=styler.install
source=('styler.pyz' 'styler.desktop' 'styler-package.xml' 'styler.1' 'LICENSE' 'NOTICE' 'README.md' 'STYLER.md')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 styler.pyz "$pkgdir/usr/lib/styler/styler.pyz"
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/styler" <<'SH'
#!/bin/sh
exec python3 /usr/lib/styler/styler.pyz "$@"
SH
  chmod 0755 "$pkgdir/usr/bin/styler"
  install -Dm644 styler.desktop "$pkgdir/usr/share/applications/styler.desktop"
  install -Dm644 styler-package.xml "$pkgdir/usr/share/mime/packages/styler-package.xml"
  install -Dm644 styler.1 "$pkgdir/usr/share/man/man1/styler.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/styler/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/styler/NOTICE"
  install -Dm644 README.md STYLER.md -t "$pkgdir/usr/share/doc/styler/"
}
