include LICENSE NOTICE README.md
include docs/STYLER.md
include docs/styler.1
include scripts/build-rust-engine.sh
recursive-include rust/styler-engine Cargo.toml *.rs
recursive-include styler/rust_ext Cargo.toml *.rs
include rust-toolchain.toml
include scripts/verify-rust-plan.py

recursive-include styler/baselines/catalog *.stylerpkg
include scripts/capture-official-baseline.sh

recursive-include styler/catalog/changes *.yaml

# PipeCraft 1.5 source is shipped for the source installer. It is compiled into
# the private Styler venv when cargo is available; it is not imported by Python.
recursive-include vendor/pipecraft-1.5.0-alpha.1 *.toml *.rs *.md *.json *.yaml *.yml *.sh LICENSE NOTICE
